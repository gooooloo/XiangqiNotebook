# Copy to .env (ignored). Supply your own values; never commit credentials.
COACH_TOKEN=
COACH_DATA_FILE=./data/coach.json
HOST=127.0.0.1
PORT=9220
# Full Chat Completions URL. Azure deployment URLs including api-version are supported.
COACH_LLM_URL=
COACH_LLM_KEY=
COACH_LLM_MODEL=
# bearer (default) or api-key (Azure)
COACH_LLM_AUTH=bearer
# Optional APNs token authentication. Private key stays on this server.
COACH_APNS_KEY_FILE=
COACH_APNS_KEY_ID=
COACH_APNS_TEAM_ID=
COACH_APNS_TOPIC=com.gooooloo.XiangqiNotebook
COACH_APNS_ENV=sandbox
